{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "schedule:weekly"
  ],
  "timezone": "Europe/Vienna",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "description": "Security remediation bypasses the routine update window and release-age delay; update-type review rules still apply."
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Allow Renovate itself to merge only after all checks, including its minimum-release-age status, pass; GitHub platform auto-merge does not reliably gate on this non-required status.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "platformAutomerge": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group action pins across workflows. Keep the Node.js runtime upgrade in its own PR.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Major updates: separate, labelled, never automerged, across every manager. Majors already fail to match the automerge rule above, so automerge is false by default; it is stated for the same reason as lockFileMaintenance. This rule deliberately carries no matchManagers so that a major GitHub Actions, Docker, or Terraform bump is labelled for review like a major code dependency.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-review"
      ]
    },
    {
      "description": "Organize the dashboard without changing PR grouping or update eligibility.",
      "matchManagers": [
        "github-actions"
      ],
      "dependencyDashboardCategory": "CI actions and runtimes"
    },
    {
      "description": "Organize the dashboard without changing PR grouping or update eligibility.",
      "matchManagers": [
        "custom.regex"
      ],
      "dependencyDashboardCategory": "Validation tooling"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the HTML validator release used by the shared validation entry point.",
      "managerFilePatterns": [
        "/^\\.github/scripts/validate_site\\.py$/"
      ],
      "matchStrings": [
        "HTML_VALIDATE_VERSION = '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "html-validate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ],
  "pruneStaleBranches": true,
  "pruneBranchAfterAutomerge": true,
  "dependencyDashboard": {
    "enabled": true,
    "header": "Renovate dependency maintenance.\n\nRoutine updates run Monday 00:00–04:00 Europe/Vienna. Non-major updates have a three-day release-age hold and may be merged by Renovate after checks pass. Major updates require review.\n\n- **Awaiting Schedule** lists work queued for its next eligible window.\n- **Pending Status Checks** can include release-age holds. Inspect the PR checks and any Renovate stability status; green CI alone does not clear the age policy.\n- Checkboxes request bot work, such as creation or rebasing; they do not approve a merge. Required checks and review still apply."
  }
}
